# Discord
DISCORD_TOKEN=
GUILD_ID=

# IDs dos canais
CHANNEL_MORNING_DIGEST=
CHANNEL_INBOX=
CHANNEL_BRAIN=

# Google Calendar
GOOGLE_CREDENTIALS_JSON=/run/secrets/google_credentials

# GitHub
GITHUB_TOKEN=
GITHUB_USERNAME=Lucas2003-18

# OpenWeatherMap
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Campinas,BR

# Vault Git
VAULT_REPO_URL=
VAULT_LOCAL_PATH=/app/vault
VAULT_GIT_NAME=Glitch Bot
VAULT_GIT_EMAIL=bot@granzo.app

# Configurações
DIGEST_HOUR=7
DIGEST_MINUTE=0
TIMEZONE=America/Sao_Paulo

# Uptime Kuma — push monitor (opcional)
# Criar monitor tipo "Push" no Kuma e colar a URL gerada aqui
# Exemplo: https://uptime.granzo.app/api/push/xXxXxXxX?status=up&msg=OK&ping=
UPTIME_KUMA_PUSH_URL=

# PushAlerts — monitoramento de infra (opcional)
# CHANNEL_ALERTS: ID do canal Discord para receber alertas automáticos (0 = desativado)
# INFRA_CHECK_INTERVAL: intervalo em segundos entre checagens (padrão: 300)
# DISK_ALERT_THRESHOLD: % de disco para disparar alerta (padrão: 90)
# CPU_ALERT_THRESHOLD: % de load/cores para disparar alerta (padrão: 80)
CHANNEL_ALERTS=
INFRA_CHECK_INTERVAL=300
DISK_ALERT_THRESHOLD=90
CPU_ALERT_THRESHOLD=80

# Dashboard Tablet (Sprint 5)
# Caminho onde o bot grava agenda.json (montado como volume compartilhado com Nginx)
DASHBOARD_DATA_PATH=/app/dashboard_shared/agenda.json
