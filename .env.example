# Discord
DISCORD_TOKEN=
GUILD_ID=

# IDs dos canais
CHANNEL_MORNING_DIGEST=
CHANNEL_INBOX=
CHANNEL_BRAIN=

# Google Calendar
GOOGLE_CREDENTIALS_JSON=/run/secrets/google_credentials

# GitHub
GITHUB_TOKEN=
GITHUB_USERNAME=Lucas2003-18

# OpenWeatherMap
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Campinas,BR

# Vault Git
VAULT_REPO_URL=
VAULT_LOCAL_PATH=/app/vault
VAULT_GIT_NAME=Glitch Bot
VAULT_GIT_EMAIL=bot@granzo.app

# Configurações
DIGEST_HOUR=7
DIGEST_MINUTE=0
TIMEZONE=America/Sao_Paulo

# Uptime Kuma — push monitor (opcional)
# Criar monitor tipo "Push" no Kuma e colar a URL gerada aqui
# Exemplo: https://uptime.granzo.app/api/push/xXxXxXxX?status=up&msg=OK&ping=
UPTIME_KUMA_PUSH_URL=

# PushAlerts — monitoramento de infra (opcional)
# CHANNEL_ALERTS: ID do canal Discord para receber alertas automáticos (0 = desativado)
# INFRA_CHECK_INTERVAL: intervalo em segundos entre checagens (padrão: 300)
# DISK_ALERT_THRESHOLD: % de disco para disparar alerta (padrão: 90)
# CPU_ALERT_THRESHOLD: % de load/cores para disparar alerta (padrão: 80)
CHANNEL_ALERTS=
INFRA_CHECK_INTERVAL=300
DISK_ALERT_THRESHOLD=90
CPU_ALERT_THRESHOLD=80

# Dashboard Tablet (Sprint 5)
# Caminho onde o bot grava agenda.json (montado como volume compartilhado com Nginx)
DASHBOARD_DATA_PATH=/app/dashboard_shared/agenda.json

# Agente de Observabilidade (Sprint 6)
# GEMINI_BRIDGE_URL: endpoint do Gemini Bridge na rede Docker interna
# INCIDENT_CHECK_INTERVAL: intervalo em minutos entre checagens de incidentes (padrão: 2)
# INCIDENT_TIMEOUT: minutos sem resposta até descartar automaticamente um incidente (padrão: 30)
GEMINI_BRIDGE_URL=http://gemini-bridge:3001
INCIDENT_CHECK_INTERVAL=2
INCIDENT_TIMEOUT=30

# INFRA_IGNORE_CONTAINERS: nomes de containers (separados por vírgula) que o
# infra_agent nunca deve monitorar — ex: containers parados intencionalmente
# que senão reabririam incidente a cada ciclo após o timeout.
INFRA_IGNORE_CONTAINERS=

# edit_file via SSH (Sprint 6 Fase 2)
# /host/root é montado read-only — edição de arquivos no host exige SSH.
# Gerar um par de chaves dedicado, colocar a pública em ~/.ssh/authorized_keys
# do INFRA_SSH_USER no NUC e montar a privada no container em INFRA_SSH_KEY.
# INFRA_SSH_HOST: IP do NUC na LAN (NÃO "localhost" — em rede bridge,
#   localhost dentro do container é o próprio container, não o host)
# INFRA_SSH_USER: usuário do NUC com permissão de escrita nos arquivos editáveis
# INFRA_SSH_KEY: caminho da chave privada dentro do container
INFRA_SSH_HOST=192.168.1.100
INFRA_SSH_USER=glitch
INFRA_SSH_KEY=/run/secrets/infra_ssh_key
